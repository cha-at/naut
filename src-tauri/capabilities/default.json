{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Naut default capability",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:app:allow-exit",
    "opener:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "clipboard-manager:allow-write-text"
  ]
}
