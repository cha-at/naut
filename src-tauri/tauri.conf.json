{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Naut",
  "version": "0.2.0",
  "identifier": "com.chakerat.naut",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8090",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Naut",
        "width": 1024,
        "height": 768,
        "minWidth": 360,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Productivity",
    "shortDescription": "Mobile-first DeepSeek chat client",
    "longDescription": "Naut is a mobile-first desktop and Android chat client for the DeepSeek API.",
    "copyright": "Copyright (c) Naut contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 26
    }
  }
}
