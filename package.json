{
  "name": "naut",
  "version": "0.2.0",
  "description": "Naut：mobile-first 的 DeepSeek 聊天客户端。",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "rspack serve -c rspack.config.ts",
    "build": "cross-env NODE_ENV=production rspack build -c rspack.config.ts",
    "type": "tsc -p tsconfig.json",
    "lint": "oxlint src rspack.config.ts",
    "format": "oxfmt --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "dev:desktop": "tauri dev",
    "build:desktop": "tauri build",
    "dev:android": "tauri android dev",
    "build:android": "tauri android build --debug --apk",
    "build:android:release": "tauri android build --apk"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@types/katex": "^0.16.5",
    "@types/mdast": "~4.0.3",
    "@types/prismjs": "^1.26.1",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "clsx": "2.1.1",
    "fflate": "0.8.3",
    "idb": "8.0.3",
    "katex": "0.16.22",
    "lucide-react": "^1.81.0",
    "mdast-util-find-and-replace": "3.0.2",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "mermaid": "11.10.1",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-llm-math": "3.1.0",
    "prismjs": "1.30.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "4.4.7"
  },
  "devDependencies": {
    "@rspack/cli": "2.3.3",
    "@rspack/core": "2.3.3",
    "@rspack/dev-server": "2.2.2",
    "@swc/helpers": "0.5.23",
    "@tauri-apps/cli": "^2.12.6",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "~20.9.2",
    "cross-env": "^10.1.0",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "oxfmt": "0.48.0",
    "oxlint": "1.63.0",
    "typescript": "7.0.2",
    "vitest": "^5.1.2"
  }
}
